NODE_ENV=development
PORT=3000
# Local Docker Compose PostgreSQL (see docker-compose.yml)
# Example: postgresql://neukleos:neukleos@localhost:5432/neukleos_erp?schema=erpdb
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/neukleos_erp?schema=erpdb
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
# Include the Next.js People app (default local port 3001)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAINS=neukleos.com,imageandtime.com,kucheza.com
# Resend (required in production). Without RESEND_API_KEY, invites still work but no email is sent.
RESEND_API_KEY=
EMAIL_FROM="Neukleos <onboarding@resend.dev>"
# People app base URL used in invite emails (sign-in link)
APP_WEB_URL=http://localhost:3001
# Optional override for authentication e2e tests (defaults to database neukleos_erp_e2e)
# E2E_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/neukleos_erp_e2e?schema=erpdb
# Dev bootstrap seed overrides (scripts/seed-auth-user.mjs — never used in production)
# SEED_ADMIN_EMAIL=dev.admin@neukleos.com
# SEED_GOOGLE_SUBJECT=dev-google-sub-neukleos-admin
# SEED_ORG_NAME=Neukleos Dev
# SEED_ORG_CODE=NEUKLEOS_DEV
