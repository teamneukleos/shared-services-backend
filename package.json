{
  "name": "neukleos-erp-api",
  "version": "0.1.0",
  "private": true,
  "description": "Neukleos ERP modular NestJS API",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.prisma\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "auth:seed-dev-admin": "node scripts/seed-auth-user.mjs",
    "auth:sign-access-token": "node scripts/sign-access-token.mjs",
    "test": "jest",
    "test:e2e:prepare": "node scripts/prepare-e2e.mjs",
    "test:e2e": "npm run test:e2e:prepare && jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.24",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "google-auth-library": "^11.3.1",
    "joi": "^18.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "resend": "^6.35.0",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.24",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "24.1.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jest": "30.0.5",
    "prettier": "3.6.2",
    "prettier-plugin-prisma": "^5.0.0",
    "prisma": "7.9.0",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.0",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.66.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "reflect-metadata"
    ]
  }
}
